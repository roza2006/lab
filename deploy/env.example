# 本地/演示环境变量示例
# 用法：复制为 deploy/.env（compose 会自动读取），或 `docker compose --env-file deploy/env.example ...`
# 仓库里不保存真实密码，这里的值只适合本机演示。

# MySQL
DB_ROOT_PASSWORD=root
DB_NAME=medical_platform
DB_PORT=3306

# Redis
REDIS_PORT=6379

# 后端
SERVER_PORT=8080

# 说明：
# - DB_ROOT_PASSWORD 只在本地用，答辩前如果机器对外开放，记得改掉。
# - 表结构由 MySQL 初始化目录执行 database/migrations 下的脚本，不需要开 Flyway；
#   想改成 Flyway 管理，把 backend 的 FLYWAY_ENABLED 设为 true，并删掉 compose 里的挂载。
# - 前端单独用 pnpm dev 起，端口 5173，代理到 SERVER_PORT。
